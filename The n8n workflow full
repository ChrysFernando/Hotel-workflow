      "parameters": {
        "jsCode": "function normalizeNewlines(text) {\n  return String(text || \"\")\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\r/g, \"\\n\")\n    .trim();\n}\n\nfunction safeGetOriginalEmail() {\n  try {\n    return normalizeNewlines(\n      $(\"Edit Fields2\").first().json?.email_request?.MessageBody\n    );\n  } catch {\n    return \"\";\n  }\n}\n\nfunction cleanTrailingDots(body) {\n  return String(body || \"\")\n    .replace(/\\s+\\.\\s*$/m, \".\")\n    .replace(/,\\s*\\.\\s*$/m, \".\");\n}\n\nconst originalEmail = safeGetOriginalEmail();\n\nreturn items.map((item) => {\n  const out = item.json?.output || item.json || {};\n\n  const subject = normalizeNewlines(out.replySubject);\n  let body = normalizeNewlines(out.replyBody);\n  body = cleanTrailingDots(body);\n\n  const approvalId =\n    out.approvalId ||\n    item.json?.approvalId ||\n    (String(out.whatsAppDraft || \"\").match(/Approval ID:\\s*([A-Z0-9-]+)/i)?.[1] ?? null);\n\n  const attachmentsFlag = Boolean(out.sendAttachments?.addAttachments);\n\n  const whatsappMessage = [\n    \"New Email Recieved!\",\n    \"\",\n    \"ORIGINAL EMAIL:\",\n    originalEmail || \"(Original email not found.)\",\n    \"\",\n    \"— — —\",\n    \"REPLY DRAFT:\",\n    subject ? `Subject: ${subject}` : \"(No subject found.)\",\n    \"\",\n    body || \"(No reply body found.)\",\n    \"\",\n    \"Shall I go ahead and send it?\",\n    \"\",\n    \"Reply with YES/NO.\"\n  ].join(\"\\n\");\n\n  return {\n    json: {\n      whatsappMessage,\n      approvalId,\n      toEmail: out.toEmail ?? null,\n      sendAttachments: { addAttachments: attachmentsFlag },\n    },\n  };\n});"
      },
